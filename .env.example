# Server Configuration
PORT=3000
CLIENT_URL=http://localhost:3000

# Supabase Configuration
# Obtain your project credentials from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# SUPABASE_ANON_KEY is accepted as an alias for SUPABASE_PUBLISHABLE_KEY
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Third-party APIs
# Get your Grok API key from https://console.x.ai
GROK_API_KEY=your-grok-api-key-here
